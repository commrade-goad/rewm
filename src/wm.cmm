typedef Rule : struct {
    class      : *const char;
    instance   : *const char;
    title      : *const char;
    tags       : unsigned int;
    isfloating : int;
    monitor    : int;
};

/* class/instance/title match -> tags/floating/monitor, like dwm's config.h rules[].
 * NULL fields match anything. tags==0 keeps whatever tag was active when
 * the window was created. Edit freely -- this is your config section. */
static rules: []const Rule = {
    /* class          instance  title     tags mask   isfloating    monitor*/
    { "mpv",          NULL,     NULL,     0,           1,           -1 },
    { "dialog",       NULL,     NULL,     0,           1,           -1 },
    { "firefox",      NULL,     NULL,     1<<1,        0,           -1 },
    { "Emacs",        NULL,     NULL,     1<<0,        0,           -1 },
};

