static int exitcode = REWM_QUIT;

static getcolor: (s: *WMState, name: *const char, alpha: unsigned int) unsigned long {
    c    : XColor;
    cmap := DefaultColormap(s.dpy, s.screen);
    if !XAllocNamedColor(s.dpy, cmap, name, &c, &c) {
        return BlackPixel(s.dpy, s.screen);
    }

    alpha &= 0xffUL;
    r: unsigned long = (c.pixel >> 16) & 0xff;
    g: unsigned long = (c.pixel >> 8)  & 0xff;
    b: unsigned long =  c.pixel        & 0xff;
    // Compositor need the alpha channel be blended on the pixel straight up
    r = (r * alpha) / 0xff;
    g = (g * alpha) / 0xff;
    b = (b * alpha) / 0xff;
    return (alpha << 24) | (r << 16) | (g << 8) | b;
}

static initvisual: (s: *WMState) void {
    vinfo : XVisualInfo;
    if XMatchVisualInfo(s.dpy, s.screen, 32, TrueColor, &vinfo) {
        s.visual = vinfo.visual;
        s.depth  = (unsigned int)vinfo.depth;
        s.cmap   = XCreateColormap(s.dpy, s.root, s.visual, AllocNone);
    } else {
        s.visual = DefaultVisual(s.dpy, s.screen);
        s.depth  = (unsigned int)DefaultDepth(s.dpy, s.screen);
        s.cmap   = DefaultColormap(s.dpy, s.screen);
    }
}

static freexftcolors: (s: *WMState) void {
    if !s.visual { return; }
    for i := 0; i < SchemeLast; i++;
        for j := 0; j < ColLast; j++;
            if s.xftcol[i][j].pixel || s.xftcol[i][j].color.alpha
                XftColorFree(s.dpy, s.visual, s.cmap, &s.xftcol[i][j]);
}

static allocxftcolor: (s: *WMState, scheme: int, col: int, name: *const char) void {
    dest := &s->xftcol[scheme][col];
    if !XftColorAllocName(s->dpy, s->visual, s->cmap, name, dest)
        fprintf(stderr, "rewm: cannot allocate Xft color '%s'\n", name);
    dest->pixel |= 0xff << 24;
}

static setupcolors: (s: *WMState) void {
    s.col[SchemeNorm][ColFg]     = getcolor(s, COL_NORM_FG,    borderalpha);
    s.col[SchemeNorm][ColBg]     = getcolor(s, COL_NORM_BG,    baralpha);
    s.col[SchemeNorm][ColBorder] = getcolor(s, COL_NORM_BORDER,borderalpha);
    s.col[SchemeSel][ColFg]      = getcolor(s, COL_SEL_FG,     borderalpha);
    s.col[SchemeSel][ColBg]      = getcolor(s, COL_SEL_BG,     baralpha);
    s.col[SchemeSel][ColBorder]  = getcolor(s, COL_SEL_BORDER, borderalpha);

    allocxftcolor(s, SchemeNorm, ColFg,     COL_NORM_FG);
    allocxftcolor(s, SchemeNorm, ColBg,     COL_NORM_BG);
    allocxftcolor(s, SchemeNorm, ColBorder, COL_NORM_BORDER);
    allocxftcolor(s, SchemeSel,  ColFg,     COL_SEL_FG);
    allocxftcolor(s, SchemeSel,  ColBg,     COL_SEL_BG);
    allocxftcolor(s, SchemeSel,  ColBorder, COL_SEL_BORDER);
}

// use setupfont() instead of this function... this used internally
static xfont_create: (s: *WMState, fontname: *const char, fontpattern: *FcPattern) *Fnt {
    xfont  : *XftFont   = NULL;
    pattern: *FcPattern = NULL;

    if fontname {
        /* Using the pattern found at xfont.pattern does not yield the
         * same substitution results as using the pattern returned by
         * FcNameParse; using the latter results in the desired fallback
         * behaviour whereas the former just results in missing-character
         * rectangles being drawn, at least with some fonts. */
        if !(xfont = XftFontOpenName(s.dpy, s.screen, fontname)) {
            fprintf(stderr, "rewm: cannot load font from name: '%s'\n", fontname);
            return NULL;
        }
        if !(pattern = FcNameParse(cast(*FcChar8)fontname)) {
            fprintf(stderr, "rewm: cannot parse font name to pattern: '%s'\n", fontname);
            XftFontClose(s.dpy, xfont);
            return NULL;
        }
    } else if fontpattern {
        if !(xfont = XftFontOpenPattern(s.dpy, fontpattern)) {
            fprintf(stderr, "rewm: cannot load font from pattern\n");
            return NULL;
        }
    } else {
        fprintf(stderr, "rewm: xfont_create: no font specified\n");
        return NULL;
    }
    font: *Fnt = calloc(1, sizeof(Fnt));
    font.xfont = xfont;
    font.pattern = pattern;
    return font;
}

static xfont_free: (s: *WMState, font: *Fnt) void {
    if !font { return; }
    if font.pattern { FcPatternDestroy(font.pattern); }
    XftFontClose(s.dpy, font.xfont);
    free(font);
}

static freefonts: (s: *WMState) void {
    while s.fonts {
        f: *Fnt = s.fonts;
        s.fonts = f.next;
        xfont_free(s, f);
    }
}

/* fonts[i] in fontnames[] are tried first, in order; anything not
 * covered by them falls through to a dynamic per-codepoint
 * XftFontMatch() lookup (see getfontforchar()) instead of just
 * drawing tofu -- so one primary font here is usually enough. */
static setupfont: (s: *WMState) void {
    freefonts(s);

    for i := (int)LENGTH(fontnames) - 1; i >= 0; i--; {
        f: *Fnt = xfont_create(s, fontnames[i], NULL);
        if !f { continue; }
        f.next = s.fonts;
        s.fonts = f;
    }

    if !s.fonts {
        f: *Fnt = xfont_create(s, "fixed", NULL);
        if f { s.fonts = f; }
    }

    if s.fonts {
        s.fonth = s.fonts.xfont.ascent + s.fonts.xfont.descent;
    } else {
        fprintf(stderr, "rewm: no fonts loaded at all, bar will be broken\n");
        s.fonth = 12;
    }
    s.lrpad = s.fonth;
    s.barheight = s.fonth + BARHEIGHT_PAD;
}

/* find a font covering `rune`: first check the already-loaded chain,
 * then fall back to a dynamic fontconfig lookup seeded from the
 * primary font's pattern, caching whatever's found onto the tail of
 * the chain so the expensive XftFontMatch call only happens once per
 * codepoint. A small negative-result cache (`nomatches`) avoids
 * re-querying fontconfig for codepoints we already know nothing
 * covers. Ported from dwm's drw_text() fallback path.
 *
 * NOTE: `nomatches` is a plain `static` (not on WMState), so it
 * resets on every hot reload -- that's fine, it's purely a perf
 * cache, not correctness-affecting. */
static getfontforchar: (s: *WMState, rune: FcChar32) *Fnt {
    static nomatches: [128]unsigned int;
    hash: unsigned int;
    h0  : unsigned int;
    h1  : unsigned int;

    for f := s.fonts; f; f = f.next;
        if XftCharExists(s.dpy, f.xfont, rune)
            return f;

    // ask fontconfig to get the font that have thsi glyph
    hash = rune;
    hash = ((hash >> 16) ^ hash) * 0x21F0AAAD;
    hash = ((hash >> 15) ^ hash) * 0xD35A2D97;
    h0   = ((hash >> 15) ^ hash) % LENGTH(nomatches);
    h1   = (hash >> 17) % LENGTH(nomatches);
    if nomatches[h0] == rune || nomatches[h1] == rune
        return s.fonts;

    if !s.fonts || !s.fonts.pattern
        return s.fonts;

    fccharset := FcCharSetCreate();
    FcCharSetAddChar(fccharset, rune);

    fcpattern := FcPatternDuplicate(s.fonts.pattern);
    FcPatternAddCharSet(fcpattern, FC_CHARSET, fccharset);
    FcPatternAddBool(fcpattern, FC_SCALABLE, FcTrue);
    FcConfigSubstitute(NULL, fcpattern, FcMatchPattern);
    FcDefaultSubstitute(fcpattern);

    result: FcResult;
    match := XftFontMatch(s.dpy, s.screen, fcpattern, &result);

    FcCharSetDestroy(fccharset);
    FcPatternDestroy(fcpattern);

    if match {
        nf := xfont_create(s, NULL, match);
        if nf && XftCharExists(s.dpy, nf.xfont, rune) {
            tail := s.fonts;
            while tail.next { tail = tail.next; }
            tail.next = nf;
            return nf;
        }
        if nf { xfont_free(s, nf); }
        nomatches[nomatches[h0] ? h1 : h0] = rune;
    }
    return s.fonts;
}

/* Shared off-screen scratch pixmap that every drawbar() call draws
 * into before XCopyArea-ing the result onto that monitor's barwin --
 * same trick your drw.c uses (drw.drawable / drw_resize), just sized
 * once to the full display width so no per-monitor resize is needed. */
static setupdrawable: (s: *WMState) void {
    w := (unsigned int)MAX(s.sw, 1);
    h := (unsigned int)MAX(s.barheight, 1);

    if s.xftdraw {
        XftDrawDestroy(s.xftdraw);
        s.xftdraw = NULL;
    }
    if s.drawable {
        XFreePixmap(s.dpy, s.drawable);
        s.drawable = 0;
    }

    s.drawable = XCreatePixmap(s.dpy, s.root, w, h, s.depth);
    s.draww    = w;
    s.drawh    = h;
    s.xftdraw  = XftDrawCreate(s.dpy, s.drawable, s.visual, s.cmap);
}

static resizedrawable: (s: *WMState, w: unsigned int, h: unsigned int) void {
    if w <= s.draww && h <= s.drawh { return; }
    if w < s.draww { w = s.draww; }
    if h < s.drawh { h = s.drawh; }
    if s.xftdraw { XftDrawDestroy(s.xftdraw); }
    if s.drawable { XFreePixmap(s.dpy, s.drawable); }
    s.drawable = XCreatePixmap(s.dpy, s.root, w, h, s.depth);
    s.draww    = w;
    s.drawh    = h;
    s.xftdraw  = XftDrawCreate(s.dpy, s.drawable, s.visual, s.cmap);
}

static setupcursors: (s: *WMState) void {
    s.cur_normal = XCreateFontCursor(s.dpy, XC_left_ptr);
    s.cur_move   = XCreateFontCursor(s.dpy, XC_fleur);
    s.cur_resize = XCreateFontCursor(s.dpy, XC_sizing);
    XDefineCursor(s.dpy, s.root, s.cur_normal);
}

static textwidth: (s: *WMState, text: *const char) int {
    if !text || !*text { return s.lrpad; }
    if !s.fonts { return (int)strlen(text) * 6 + s.lrpad; }

    w := 0;
    p : *const char = text;
    while p.* {
        rune : FcChar32;
        clen := FcUtf8ToUcs4((FcChar8 *)p, &rune, (int)strlen(p));
        if clen <= 0 { clen = 1; }
        f := getfontforchar(s, rune);
        ext: XGlyphInfo;
        XftTextExtentsUtf8(s.dpy, f.xfont, (const FcChar8 *)p, clen, &ext);
        w += ext.xOff;
        p += clen;
    }
    return w + s.lrpad;
}

static updatebarpos:(s: *WMState, m: *Monitor) void {
    m.wy = m.my;
    m.wh = m.mh;
    if m.showbar {
        m.wh -= s.barheight;
        m.wy = m.topbar ? m.wy + s.barheight : m.wy;
    }
}

static drawrect: (s: *WMState, x: int, y: int, w: int, h: int, pixel: unsigned long, fill: int) void {
    XSetForeground(s.dpy, s.gc, pixel);
    if fill {
        XFillRectangle(s.dpy, s.drawable, s.gc, x, y, (unsigned)w, (unsigned)h);
    } else {
        /* Draw 4 sides with XFillRectangle instead of XDrawRectangle(…, w-1, h-1).
         * XDrawRectangle's corner rendering drops the bottom-right pixel on
         * some drivers/servers; 4 side fills are unambiguous and cost is
         * negligible (bar redraws a few times/sec). */
        XFillRectangle(s.dpy, s.drawable, s.gc, x, y, (unsigned)w, 1);
        XFillRectangle(s.dpy, s.drawable, s.gc, x, y + h - 1, (unsigned)w, 1);
        XFillRectangle(s.dpy, s.drawable, s.gc, x, y, 1, (unsigned)h);
        XFillRectangle(s.dpy, s.drawable, s.gc, x + w - 1, y, 1, (unsigned)h);
    }
}

/* UTF-8 helpers for title truncation */
static utf8charlen: (p: *const char) int {
    c := (unsigned char)*p;
    if !c return 0;
    if c < 0x80 return 1;
    if c < 0xC0 return 1;
    if c < 0xE0 return 2;
    if c < 0xF0 return 3;
    return 4;
}

static utf8strlen: (s: *const char) int {
    n := 0;
    while s.* {
        s += utf8charlen(s);
        n++;
    }
    return n;
}

static truncate_utf8: (src: *const char, dst: *char, dstsize: size_t, max_cp: int) void {
    cp := 0;
    pos: size_t = 0;
    while src[pos] && cp < max_cp {
        clen := utf8charlen(&src[pos]);
        if pos + (size_t)clen >= dstsize break;
        for i := 0; i < clen; i++; { dst[pos + i] = src[pos + i]; }
        pos += (size_t)clen;
        cp++;
    }
    if src[pos] {
        e: *const char = "\xe2\x80\xa6"; /* … (U+2026, UTF-8) */
        if pos + 3 < dstsize {
            dst[pos++] = e[0];
            dst[pos++] = e[1];
            dst[pos++] = e[2];
        }
    }
    if pos < dstsize { dst[pos] = '\0'; }
    else dst[dstsize - 1] = '\0';
}

static drawtext: (s: *WMState, x: int, y: int, fg: unsigned long, bg: unsigned long,
                  xfg: *XftColor, w: int, h: int, text: *const char) void {
    (void)y;
    (void)fg;
    XSetForeground(s.dpy, s.gc, bg);
    XFillRectangle(s.dpy, s.drawable, s.gc, x, 0, (unsigned)w, (unsigned)h);
    if !text || !*text || !s.fonts { return; }

    /* per-glyph fallback: draw one codepoint at a time, picking
     * whichever font in the chain actually has that glyph. No run
     * batching -- simpler, and the bar redraws are infrequent/cheap
     * enough that per-glyph XftDrawStringUtf8 calls don't matter. */
    cx := x + s.lrpad / 2;
    p: *const char = text;
    while p.* {
        rune: FcChar32;
        clen := FcUtf8ToUcs4(cast(*FcChar8)p, &rune, cast(int)strlen(p));
        if clen <= 0 { clen = 1; }
        f  := getfontforchar(s, rune);
        ty := (h - (f.xfont.ascent + f.xfont.descent)) / 2 + f.xfont.ascent;
        XftDrawStringUtf8(s.xftdraw, xfg, f.xfont, cx, ty, cast(*const FcChar8)p, clen);
        XGlyphInfo ext;
        XftTextExtentsUtf8(s.dpy, f.xfont, cast(*const FcChar8)p, clen, &ext);
        cx += ext.xOff;
        p += clen;
    }
}

static updatebarname: (s: *WMState, m: *Monitor) void {
    if !m || !m.barwin { return; }
    focusedmon := (m == s.selmon);
    if m.barfocused == focusedmon { return; }
    m.barfocused = focusedmon;
    XStoreName(s.dpy, m.barwin, focusedmon ? "focused" : "unfocused");
}

static drawbar: (s: *WMState, m: *Monitor) void {
    if !m || !m.showbar || m.barwin == 0 { return; }
    updatebarname(s, m);
    resizedrawable(s, (unsigned)m.ww, (unsigned)s.barheight);

    x   := 0;
    occ := 0;
    urg := 0;
    for c := m.clients; c; c = c.next; {
        occ |= (int)c.tags;
        if c.isurgent { urg |= (int)c.tags; }
    }

    /* tags */
    for i := 0; i < (int)LENGTH(tagnames); i++; {
        sel       := (m.tagset[m.seltags] & (1u << i)) != 0;
        tagurgent := (urg & (1 << i)) != 0;
        w         := textwidth(s, tagnames[i]);
        scheme    := sel ? SchemeSel : SchemeNorm;

        fg: unsigned long = s.col[scheme][ColFg];
        bg: unsigned long = s.col[scheme][ColBg];

        xftfg := &s.xftcol[scheme][ColFg];
        if tagurgent && s.urgent_flash_on {
            /* flash: invert the whole tag block instead of just a dot */
            fg = s.col[scheme][ColBg];
            bg = s.col[scheme][ColFg];
            xftfg = &s.xftcol[scheme][ColBg];
        }
        drawtext(s, x, 0, fg, bg, xftfg, w, s.barheight, tagnames[i]);
//        if occ & (1 << i) && !tagurgent {
        if occ & (1 << i) {
            drawrect(s, x + 2, 2, 4, 4, fg, 1);
        }
        x += w;
    }

    /* layout symbol */
    lw := textwidth(s, m.ltsymbol);
    drawtext(s, x, 0, s.col[SchemeNorm][ColFg], s.col[SchemeNorm][ColBg],
             &s.xftcol[SchemeNorm][ColFg], lw, s.barheight, m.ltsymbol);
    x += lw;

    /* status text on far right */
    sw  := textwidth(s, s.statustext);
    mid := m.ww - sw;
    if mid < x { mid = x; }
    drawtext(s, mid, 0, s.col[SchemeNorm][ColFg], s.col[SchemeNorm][ColBg],
             &s.xftcol[SchemeNorm][ColFg], m.ww - mid, s.barheight, s.statustext);

    /* selected window title fills the middle */
    tw := mid - x;
    if tw > 0 {
        sel := s.sel;
        raw : *const char = (sel && sel.mon == m) ? sel.name : "";
        truncated: [256]char;
        truncate_utf8(raw, truncated, sizeof(truncated), TITLE_MAX_CHARS);
        drawtext(s, x, 0, s.col[SchemeNorm][ColFg], s.col[SchemeNorm][ColBg],
                 &s.xftcol[SchemeNorm][ColFg], tw, s.barheight, truncated);
        if sel && sel.mon == m && sel.isfloating {
            drawrect(s, x + 1, 2, 4, 4, s.col[SchemeNorm][ColFg], 1);
            tw = mid - x;
        }
    }

    XCopyArea(s.dpy, s.drawable, m.barwin, s.gc, 0, 0,
              (unsigned)m.ww, (unsigned)s.barheight, 0, 0);
}

static drawbars: (s: *WMState) void {
    for m := s.mons; m; m = m.next;
        drawbar(s, m);
}

static updatestatus: (s: *WMState) void {
    list : **char = NULL;
    n    : int;
    tp   : XTextProperty;

    s.statustext[0] = '\0';
    if XGetTextProperty(s.dpy, s.root, &tp, XA_WM_NAME) && tp.nitems > 0 {
        if tp.encoding == XA_STRING {
            strncpy(s.statustext, cast(*char)tp.value, sizeof(s.statustext) - 1);
        } else if XmbTextPropertyToTextList(s.dpy, &tp, &list, &n) >= Success
                   && n > 0 && list && list.* {
            strncpy(s.statustext, list.*, sizeof(s.statustext) - 1);
            XFreeStringList(list);
        }
        s.statustext[sizeof(s.statustext) - 1] = '\0';
        XFree(tp.value);
    }
    if !s.statustext[0] {
        strncpy(s.statustext, "rewm", sizeof(s.statustext) - 1);
    }
}

static applysizehints: (s: *WMState, c: *Client, x: *int, y: *int, w: *int, h: *int, interact: int) int {
    baseismin: int;
    m        := c.mon;

    if !c.hintsvalid {
        updatesizehints(s, c);
    }

    if interact {
        if (*x > s.sw) *x = s.sw - c.w;
        if (*y > s.sh) *y = s.sh - c.h;
        if (*x + *w + 2 * c.bw < 0) *x = 0;
        if (*y + *h + 2 * c.bw < 0) *y = 0;
    } else {
        if (*x >= m.wx + m.ww) *x = m.wx + m.ww - c.w;
        if (*y >= m.wy + m.wh) *y = m.wy + m.wh - c.h;
        if (*x + *w + 2 * c.bw <= m.wx) *x = m.wx;
        if (*y + *h + 2 * c.bw <= m.wy) *y = m.wy;
    }
    if h.* < s.barheight { h.* = s.barheight; }
    if w.* < s.barheight { w.* = s.barheight; }

    if resizehints || c.isfloating || layouts[m.sellt].arrange == floating {
        if !c.basew && !c.baseh {
            c.basew = c.baseh = 0;
        }
        baseismin = (c.basew == c.minw && c.baseh == c.minh);
        if !baseismin {
            if c.minw && w.* < c.minw { w.* = c.minw; }
            if c.minh && h.* < c.minh { h.* = c.minh; }
        }
        if c.maxw && w.* > c.maxw { w.* = c.maxw; }
        if c.maxh && h.* > c.maxh { h.* = c.maxh; }

        if c.basew && c.incw {
            w.* -= (w.* - c.basew) % c.incw;
        }
        if c.baseh && c.inch {
            h.* -= (h.* - c.baseh) % c.inch;
        }

        if c.maxa > 0.0f && c.mina > 0.0f {
            if cast(float)w.* / h.* > c.maxa {
                h.* = cast(int)(cast(float)w.* / c.maxa + 0.5f);
            } else if cast(float)w.* / h.* < c.mina {
                w.* = cast(int)(cast(float)(h.*) * c.mina + 0.5f);
            }
        }
    }

    return (c.oldx != x.* || c.oldy != y.* || c.oldw != w.* || c.oldh != h.*);
}

static configure: (s: *WMState, c: *Client) void {
    ce: XConfigureEvent;
    ce.type                     = ConfigureNotify;
    ce.display                  = s.dpy;
    ce.event                    = c.win;
    ce.window                   = c.win;
    ce.x                        = c.x;
    ce.y                        = c.y;
    ce.width                    = c.w;
    ce.height                   = c.h;
    ce.border_width             = c.bw;
    ce.above                    = None;
    ce.override_redirect        = False;
    XSendEvent(s.dpy, c.win, False, StructureNotifyMask, (XEvent *)&ce);
}

static resizeclient: (s: *WMState, c: *Client, x: int, y: int, w: int, h: int) void {
    wc: XWindowChanges;
    c.oldx = c.x; c.x = wc.x = x;
    c.oldy = c.y; c.y = wc.y = y;
    c.oldw = c.w; c.w = wc.width = w;
    c.oldh = c.h; c.h = wc.height = h;
    wc.border_width = c.bw;
    XConfigureWindow(s.dpy, c.win, CWX|CWY|CWWidth|CWHeight|CWBorderWidth, &wc);
    configure(s, c);
}

static resize: (s: *WMState, c: *Client, x: int, y: int, w: int, h: int, interact: int) void {
    applysizehints(s, c, &x, &y, &w, &h, interact);
    resizeclient(s, c, x, y, w, h);
}

static isvisible: (m: *Monitor, c: *Client) int {
    return c.issticky || (c.tags & m.tagset[m.seltags]) != 0;
}

static showhide: (s: *WMState, c: *Client) void {
    if !c return;
    if isvisible(c.mon, c) {
        XMoveWindow(s.dpy, c.win, c.x, c.y);
        if c.isfloating && !c.isfullscreen {
            resize(s, c, c.x, c.y, c.w, c.h, 0);
        }
        showhide(s, c.snext);
    } else {
        showhide(s, c.snext);
        XMoveWindow(s.dpy, c.win, -2 * c.w - 100, c.y);
    }
}

static setclientstate: (s: *WMState, c: *Client, state: long) void {
    data: []long = { state, None };
    XChangeProperty(s.dpy, c.win, s.wm_state, s.wm_state, 32,
                    PropModeReplace, cast(*unsigned char)data, 2);
}

static sendevent: (s: *WMState, w: Window, proto: Atom, d0: long, d1: long, d2: long, d3: long, d4: long) int {
    n: int;
    protocols: *Atom;
    mt: Atom;
    exists := 0;
    ev: XEvent;

    if proto != s.wm_protocols {
        mt = s.wm_protocols;
        if XGetWMProtocols(s.dpy, w, &protocols, &n) {
            while n-- > 0 {
                if protocols[n] == proto { exists = 1; break; }
            }
            XFree(protocols);
        }
    } else {
        mt = s.wm_protocols;
        exists = 1;
    }
    if exists {
        ev.type                 = ClientMessage;
        ev.xclient.window       = w;
        ev.xclient.message_type = mt;
        ev.xclient.format       = 32;
        ev.xclient.data.l[0]    = d0;
        ev.xclient.data.l[1]    = d1;
        ev.xclient.data.l[2]    = d2;
        ev.xclient.data.l[3]    = d3;
        ev.xclient.data.l[4]    = d4;
        XSendEvent(s.dpy, w, False, NoEventMask, &ev);
    }
    return exists;
}

static setfocus: (s: *WMState, c: *Client) void {
    if !c.neverfocus {
        XSetInputFocus(s.dpy, c.win, RevertToPointerRoot, CurrentTime);
        XChangeProperty(s.dpy, s.root, s.net_active_window, XA_WINDOW, 32,
                        PropModeReplace, cast(*unsigned char)&c.win, 1);
    }
    sendevent(s, c.win, s.wm_protocols, s.wm_take_focus, CurrentTime, 0, 0, 0);
}

static unfocus: (s: *WMState, c: *Client, setfocusflag: int) void {
    if !c return;
    grabbuttons(s, c, 0);
    XSetWindowBorder(s.dpy, c.win, s.col[SchemeNorm][ColBorder]);
    if setfocusflag {
        XSetInputFocus(s.dpy, s.root, RevertToPointerRoot, CurrentTime);
        XDeleteProperty(s.dpy, s.root, s.net_active_window);
    }
}

static focus: (s: *WMState, c: *Client) void {
    if !c || !isvisible(c.mon, c) {
        for (c = s.selmon.stack; c && !isvisible(c.mon, c); c = c.snext);
    }
    if s.sel && s.sel != c {
        unfocus(s, s.sel, 0);
    }
    if c {
        if c.mon != s.selmon { s.selmon = c.mon; }
        if c.isurgent        { c.isurgent = 0; }
        detachstack(s, c);
        attachstack(s, c);
        grabbuttons(s, c, 1);
        XSetWindowBorder(s.dpy, c.win, s.col[SchemeSel][ColBorder]);
        setfocus(s, c);
    } else {
        XSetInputFocus(s.dpy, s.root, RevertToPointerRoot, CurrentTime);
        XDeleteProperty(s.dpy, s.root, s.net_active_window);
    }
    s.sel = c;
    drawbars(s);
}

static grabbuttons: (s: *WMState, c: *Client, focused: int) void {
    XUngrabButton(s.dpy, AnyButton, AnyModifier, c.win);
    if !focused {
        XGrabButton(s.dpy, AnyButton, AnyModifier, c.win, False,
                    ButtonPressMask, GrabModeSync, GrabModeSync, None, None);
    }
    mods: []unsigned int = { 0, LockMask, numlockmask, numlockmask | LockMask };
    for i := 0; i < cast(int)LENGTH(mods); i++; {
        XGrabButton(s.dpy, Button1, MODKEY | mods[i], c.win, False,
                    ButtonPressMask | ButtonMotionMask | ButtonReleaseMask,
                    GrabModeAsync, GrabModeAsync, None, None);
        XGrabButton(s.dpy, Button3, MODKEY | mods[i], c.win, False,
                    ButtonPressMask | ButtonMotionMask | ButtonReleaseMask,
                    GrabModeAsync, GrabModeAsync, None, None);
    }
}

static grabkeys:(s: *WMState) void {
    updatenumlockmask(s);
    XUngrabKey(s.dpy, AnyKey, AnyModifier, s.root);

    mincode: int;
    maxcode: int;
    XDisplayKeycodes(s.dpy, &mincode, &maxcode);
    keysyms_per_keycode: int;
    keysyms := XGetKeyboardMapping(s.dpy, mincode, maxcode - mincode + 1, &keysyms_per_keycode);
    if !keysyms return;

    for kc := mincode; kc <= maxcode; kc++; {
        keysym := keysyms[(kc - mincode) * keysyms_per_keycode];
        for i := 0; i < KEY_COUNT; i++; {
            if keysym == keys[i].keysym {
                mods: []unsigned int = { 0, LockMask, numlockmask, numlockmask | LockMask };
                for j := 0; j < cast(int)LENGTH(mods); j++;
                    XGrabKey(s.dpy, kc, keys[i].mod | mods[j], s.root, True,
                             GrabModeAsync, GrabModeAsync);
            }
        }
    }
    XFree(keysyms);
}

static updatenumlockmask: (s: *WMState) void {
    numlockmask = 0;
    modmap := XGetModifierMapping(s.dpy);
    nl := XKeysymToKeycode(s.dpy, XK_Num_Lock);
    for i := 0; i < 8; i++;
        for j := 0; j < modmap.max_keypermod; j++;
            if modmap.modifiermap[i * modmap.max_keypermod + j] == nl {
                numlockmask = (1 << i);
            }
    XFreeModifiermap(modmap);
}

static updatetitle: (s: *WMState, c: *Client) void {
    tp: XTextProperty;
    if XGetTextProperty(s.dpy, c.win, &tp, s.net_wm_name) && tp.value {
        strncpy(c.name, cast(*char)tp.value, sizeof(c.name) - 1);
        c.name[sizeof(c.name) - 1] = '\0';
        XFree(tp.value);
        return;
    }
    if XGetTextProperty(s.dpy, c.win, &tp, XA_WM_NAME) && tp.value {
        strncpy(c.name, cast(*char)tp.value, sizeof(c.name) - 1);
        c.name[sizeof(c.name) - 1] = '\0';
        XFree(tp.value);
        return;
    }
    strncpy(c.name, "broken", sizeof(c.name) - 1);
}

static updatesizehints: (s: *WMState, c: *Client) void {
    msize: long;
    hints: XSizeHints;
    if !XGetWMNormalHints(s.dpy, c.win, &hints, &msize) {
        hints.flags = 0;
    }
    if hints.flags & PBaseSize { c.basew = hints.base_width; c.baseh = hints.base_height; }
    else if hints.flags & PMinSize { c.basew = hints.min_width; c.baseh = hints.min_height; }
    else { c.basew = c.baseh = 0; }
    if hints.flags & PResizeInc { c.incw = hints.width_inc; c.inch = hints.height_inc; }
    else { c.incw = c.inch = 0; }
    if hints.flags & PMaxSize { c.maxw = hints.max_width; c.maxh = hints.max_height; }
    else { c.maxw = c.maxh = 0; }
    if hints.flags & PMinSize { c.minw = hints.min_width; c.minh = hints.min_height; }
    else if hints.flags & PBaseSize { c.minw = hints.base_width; c.minh = hints.base_height; }
    else { c.minw = c.minh = 0; }
    if hints.flags & PAspect {
        c.mina = cast(float)hints.min_aspect.y / hints.min_aspect.x;
        c.maxa = cast(float)hints.max_aspect.x / hints.max_aspect.y;
    } else {
        c.mina = c.maxa = 0.0f;
    }
    c.isfixed = (c.maxw && c.maxh && c.maxw == c.minw && c.maxh == c.minh);
    c.hintsvalid = 1;
}

static updatewmhints: (s: *WMState, c: *Client) void {
    wmh := XGetWMHints(s.dpy, c.win);
    if !wmh return;
    if c == s.sel && (wmh.flags & XUrgencyHint) {
        wmh.flags &= ~XUrgencyHint;
        XSetWMHints(s.dpy, c.win, wmh);
    } else {
        c.isurgent = (wmh.flags & XUrgencyHint) ? 1 : 0;
    }
    c.neverfocus = (wmh.flags & InputHint) ? !wmh.input : 0;
    XFree(wmh);
}

static updatewindowtype: (s: *WMState, c: *Client) void {
    actual: Atom;
    format: int;
    n     : unsigned long;
    extra : unsigned long;
    data  : *unsigned char = NULL;
    if XGetWindowProperty(s.dpy, c.win, s.net_wm_window_type, 0, 1, False, XA_ATOM,
                          &actual, &format, &n, &extra, &data) == Success && data {
        t := (cast(*Atom)data).*;
        XFree(data);
        if t == s.net_wm_window_type_dialog {
            c.isfloating = 1;
        }
        if (t == s.net_wm_fullscreen) {
            setfullscreen(s, c, 1);
        }
        if (t == s.net_wm_sticky) {
            setsticky(s, c, 1);
        }
    }
}

static attach: (s: *WMState, c: *Client) void {
    c.next = c.mon.clients;
    c.mon.clients = c;
    syncglobalclients(s);
}

static attachaside: (s: *WMState, c: *Client) void {
    at := nexttagged(c);
    if !at {
        attach(s, c);
        return;
    }
    c.next = at.next;
    at.next = c;
    syncglobalclients(s);
}

static nexttagged: (c: *Client) *Client {
    walked: *Client;
    for (walked = c.mon.clients; walked && (walked.isfloating || !(walked.tags & c.tags)); walked = walked.next);
    return walked;
}

static detach: (s: *WMState, c: *Client) void {
    tc: **Client;
    for (tc = &c.mon.clients; *tc && *tc != c; tc = &(*tc).next);
    if tc.* { tc.* = c.next; }
    syncglobalclients(s);
}

static attachstack: (s: *WMState, c: *Client) void {
    (void)s;
    c.snext = c.mon.stack;
    c.mon.stack = c;
}

static detachstack: (s: *WMState, c: *Client) void {
    (void)s;
    tc: **Client;
    for (tc = &c.mon.stack; *tc && *tc != c; tc = &(*tc).snext);
    if tc.* { tc.* = c.snext; }
}

static syncglobalclients:(s: *WMState) void {
    XDeleteProperty(s.dpy, s.root, s.net_client_list);
    for m := s.mons; m; m = m.next;
        for c := m.clients; c; c = c.next;
            XChangeProperty(s.dpy, s.root, s.net_client_list, XA_WINDOW, 32,
                            PropModeAppend, cast(*unsigned char)&c.win, 1);
}

static nexttiled: (c: *Client) *Client {
    for (; c && (c.isfloating || !isvisible(c.mon, c)); c = c.next);
    return c;
}

static recttomon: (s: *WMState, x: int, y: int, w: int, h: int) *Monitor {
    m: *Monitor = NULL;
    r: *Monitor = s.selmon;
    a          := 0;
    area       := 0;
    for m = s.mons; m; m = m.next; {
        if ((a = INTERSECT(x, y, w, h, m)) > area) {
            area = a;
            r = m;
        }
    }
    return r;
}

static wintomon: (s: *WMState, w: Window) *Monitor {
    x: int; y: int;
    if w == s.root && getrootptr(s, &x, &y) {
        return recttomon(s, x, y, 1, 1);
    }
    c := wintoclient(s, w);
    if c { return c.mon; }
    return s.selmon;
}

static wintoclient: (s: *WMState, w: Window) *Client {
    for m := s.mons; m; m = m.next;
        for c := m.clients; c; c = c.next;
            if (c.win == w) return c;
    return NULL;
}

static seturgent: (s: *WMState, c: *Client, urg: int) void {
    c.isurgent = urg;
    wmh := XGetWMHints(s.dpy, c.win);
    if !wmh { return; }
    wmh.flags = urg ? (wmh.flags | XUrgencyHint) : (wmh.flags & ~XUrgencyHint);
    XSetWMHints(s.dpy, c.win, wmh);
    XFree(wmh);
}

static setfullscreen: (s: *WMState, c: *Client, fullscreen: int) void {
    if fullscreen && !c.isfullscreen {
        XChangeProperty(s.dpy, c.win, s.net_wm_state, XA_ATOM, 32,
                        PropModeReplace, cast(*unsigned char)&s.net_wm_fullscreen, 1);
        c.isfullscreen = 1;
        c.wasfloating = c.isfloating;
        c.oldbw = c.bw;
        c.bw = 0;
        c.isfloating = 1;
        resizeclient(s, c, c.mon.mx, c.mon.my, c.mon.mw, c.mon.mh);
        XRaiseWindow(s.dpy, c.win);
    } else if !fullscreen && c.isfullscreen {
        XChangeProperty(s.dpy, c.win, s.net_wm_state, XA_ATOM, 32,
                        PropModeReplace, cast(*unsigned char)0, 0);
        c.isfullscreen = 0;
        c.isfloating = c.wasfloating;
        c.bw = c.oldbw;
        c.x = c.oldx; c.y = c.oldy; c.w = c.oldw; c.h = c.oldh;
        resizeclient(s, c, c.x, c.y, c.w, c.h);
        arrange(s, c.mon);
    }
}

/* Returns non-zero if a matching rule pinned this client to an explicit
 * tag mask (r.tags != 0). Callers use that to know whether they should
 * follow the client to its assigned workspace/monitor instead of leaving
 * it to open silently wherever it isn't currently being looked at. */
static applyrules: (s: *WMState, c: *Client) int {
    ch: XClassHint = {};
    XGetClassHint(s.dpy, c.win, &ch);
    class: *const char    = ch.res_class ? ch.res_class : "broken";
    instance: *const char = ch.res_name  ? ch.res_name  : "broken";
    tagrule := 0;

    for i := 0; i < cast(int)LENGTH(rules); i++; {
        r: *const Rule = &rules[i];
        if ((!r.title || strstr(c.name, r.title))
            && (!r.class || strstr(class, r.class))
            && (!r.instance || strstr(instance, r.instance))) {
            c.isfloating = r.isfloating;
            c.tags |= r.tags;
            if r.tags { tagrule = 1; }
            if r.monitor >= 0 {
                for m := s.mons; m; m = m.next; {
                    if m.num == r.monitor {
                        c.mon = m;
                        break;
                    }
                }
            }
        }
    }
    if ch.res_class { XFree(ch.res_class); }
    if ch.res_name  { XFree(ch.res_name); }

    if c.mon {
        c.tags = (c.tags & TAGMASK)
                 ? (c.tags & TAGMASK)
                 : c.mon.tagset[c.mon.seltags];
    }
    return tagrule;
}

static createclient: (s: *WMState, w: Window, wa: *XWindowAttributes) *Client {
    c: *Client = calloc(1, sizeof(*c));
    if !c { return NULL; }
    c.win  = w;
    c.x    = wa.x;
    c.y    = wa.y;
    c.w    = wa.width;
    c.h    = wa.height;
    c.oldx = c.x;
    c.oldy = c.y;
    c.oldw = c.w;
    c.oldh = c.h;
    c.bw   = border_px;
    c.oldbw= wa.border_width;
    c.mon  = s.selmon;
    c.tags = 0;

    updatetitle(s, c);
    updatesizehints(s, c);
    updatewmhints(s, c);

    trans:   Window = None;
    parent: *Client = NULL;
    ruletagged     := 0;
    if XGetTransientForHint(s.dpy, w, &trans) && (parent = wintoclient(s, trans)) {
        c.isfloating    = 1;
        c.mon           = parent.mon;
        c.tags          = parent.tags;
    } else {
        ruletagged = applyrules(s, c);
    }

    updatewindowtype(s, c);

    c.x = c.mon.mx + (c.mon.mw - (c.w + 2 * c.bw)) / 2;
    c.y = c.mon.my + (c.mon.mh - (c.h + 2 * c.bw)) / 2;

    XSetWindowBorderWidth(s.dpy, w, (unsigned)c.bw);
    XSetWindowBorder(s.dpy, w, s.col[SchemeNorm][ColBorder]);
    configure(s, c);
    XSelectInput(s.dpy, w, EnterWindowMask | FocusChangeMask | PropertyChangeMask | StructureNotifyMask);
    grabbuttons(s, c, 0);
    if !c.isfloating { c.isfloating = c.isfixed; }

    if c.isfloating {
        XRaiseWindow(s.dpy, c.win);
    }

    attachaside(s, c);
    attachstack(s, c);

    XChangeProperty(s.dpy, s.root, s.net_client_list, XA_WINDOW, 32,
                    PropModeAppend, cast(*unsigned char)&w, 1);
    XMoveResizeWindow(s.dpy, c.win, c.x + 2 * s.sw, c.y, (unsigned)c.w, (unsigned)c.h);
    setclientstate(s, c, NormalState);

    #ifdef FOLLOW_WINDOW_RULE
    if ruletagged && c.mon {
        s.selmon = c.mon;
        if !(c.tags & c.mon.tagset[c.mon.seltags]) {
            c.mon.seltags ^= 1;
            c.mon.tagset[c.mon.seltags] = c.tags & TAGMASK;
        }
    }
    #endif // FOLLOW_WINDOW_RULE

    if c.mon == s.selmon {
        if s.sel { unfocus(s, s.sel, 0); }
        s.sel = c;
    }
    arrange(s, c.mon);
    drawbars(s);
    XMapWindow(s.dpy, w);
    #ifdef FOLLOW_WINDOW_RULE
    focus(s, ruletagged ? c : NULL);
    #else
    focus(s, NULL);
    #endif // FOLLOW_WINDOW_RULE
    return c;
}

static unmanage:(s: *WMState, c: *Client, destroyed: int) void {
    m := c.mon;
    detach(s, c);
    detachstack(s, c);
    if !destroyed {
        XGrabServer(s.dpy);
        XSelectInput(s.dpy, c.win, NoEventMask);
        XUngrabButton(s.dpy, AnyButton, AnyModifier, c.win);
        setclientstate(s, c, WithdrawnState);
        XSetWindowBorderWidth(s.dpy, c.win, (unsigned)c.oldbw);
        XSync(s.dpy, False);
        XUngrabServer(s.dpy);
    }
    if s.sel == c { s.sel = NULL; }
    free(c);
    focus(s, NULL);
    arrange(s, m);
}

static buttonpress: (s: *WMState, e: *XEvent) void {
    ev: *XButtonPressedEvent = &e.xbutton;
    clickregion: unsigned int = 0; /* 0=unset, 1=tagbar, 2=ltsymbol, 3=wintitle, 4=status */

    for m := s.mons; m; m = m.next; {
        if ev.window == m.barwin {
            s.selmon = m;
            x := 0;
            /* check tag bar region */
            for i := 0; i < (int)LENGTH(tagnames); i++; {
                w := textwidth(s, tagnames[i]);
                if ev.x >= x && ev.x < x + w {
                    a: Arg;
                    a.ui = 1u << i;
                    mod: unsigned int = CLEANMASK(ev.state);
                    if mod == CLEANMASK(MODKEY) {
                        if (ev.button == Button1) tagclient(s, &a);
                        else if (ev.button == Button3) toggletag(s, &a);
                    } else {
                        if (ev.button == Button1) view(s, &a);
                        else if (ev.button == Button3) toggleview(s, &a);
                    }
                    return;
                }
                x += w;
            }
            /* check layout symbol region */
            lw := textwidth(s, m.ltsymbol);
            if ev.x >= x && ev.x < x + lw {
                clickregion = 2;
                if ev.button == Button1 {
                    a: Arg;
                    a.i = -1;
                    setlayout(s, &a); /* cycle */
                } else if ev.button == Button3 {
                    a: Arg;
                    a.i = 1;
                    setlayout(s, &a); /* monocle */
                }
                return;
            }
            x += lw;
            /* check status text region (right side) */
            sw := textwidth(s, s.statustext);
            if ev.x >= m.ww - sw {
                clickregion = 4;
                if ev.button == Button2 {
                    a: Arg;
                    a.v = termcmd;
                    spawn(s, &a);
                }
                return;
            }
            /* otherwise it's window title region */
            clickregion = 3;
            if ev.button == Button2 {
                a: Arg;
                a.i = 0;
                zoom(s, &a);
            }
            return;
        }
    }

    c := wintoclient(s, ev.window);
    if !c { return; }

    focus(s, c);
    restack(s, s.selmon);
    XAllowEvents(s.dpy, ReplayPointer, CurrentTime);

    cleanmod: unsigned int  = CLEANMASK(ev.state);
    if cleanmod == CLEANMASK(MODKEY) && ev.button == Button1 {
        Arg a; a.i = 0;
        movemouse(s, &a);
    } else if cleanmod == CLEANMASK(MODKEY) && ev.button == Button2 {
        Arg a; a.i = 0;
        togglefloating(s, &a);
    } else if cleanmod == CLEANMASK(MODKEY) && ev.button == Button3 {
        Arg a; a.i = 0;
        resizemouse(s, &a);
    }
}

static keypress: (s: *WMState, e: *XEvent) void {
    ev := &e.xkey;
    ks := XKeycodeToKeysym(s.dpy, ev.keycode, 0);
    mod: unsigned int = CLEANMASK(ev.state);

    for i := 0; i < KEY_COUNT; i++; {
        if ks == keys[i].keysym &&
           mod == CLEANMASK(keys[i].mod) &&
           keys[i].func
        {
            keys[i].func(s, &keys[i].arg);
            return;
        }
    }
}

static enternotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xcrossing;
    if ((ev.mode != NotifyNormal || ev.detail == NotifyInferior) &&
        ev.window != s.root)
    {
            return;
    }
    c := wintoclient(s, ev.window);
    m := c ? c.mon : wintomon(s, ev.window);
    if (m != s.selmon) s.selmon = m;
    else if (!c || c == s.sel) return;
    focus(s, c);
}

static expose: (s: *WMState, e: *XEvent) void {
    ev := &e.xexpose;
    if ev.count == 0 {
        for m := s.mons; m; m = m.next; {
            if (m.barwin == ev.window) drawbar(s, m);
        }
    }
}

static destroynotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xdestroywindow;
    c  := wintoclient(s, ev.window);
    if (c) unmanage(s, c, 1);
}

static unmapnotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xunmap;
    c  := wintoclient(s, ev.window);
    if (c && !ev.send_event) unmanage(s, c, 0);
}

static iswmwin: (s: *WMState, w: Window) int {
    if (w == s.wmcheckwin) return 1;
    for m := s.mons; m; m = m.next; {
        if (w == m.barwin) return 1;
    }
    return 0;
}

static maprequest: (s: *WMState, e: *XEvent) void {
    ev := &e.xmaprequest;
    wa: XWindowAttributes;
    if (!XGetWindowAttributes(s.dpy, ev.window, &wa)) return;
    if (wa.override_redirect) return;
    if (iswmwin(s, ev.window)) return;
    if (wintoclient(s, ev.window)) return;
    createclient(s, ev.window, &wa);
}

static configurerequest: (s: *WMState, e: *XEvent) void {
    ev := &e.xconfigurerequest;
    c  := wintoclient(s, ev.window);
    if c {
        if (ev.value_mask & CWBorderWidth) c.bw = ev.border_width;
        if (c.isfloating || layouts[c.mon.sellt].arrange == floating) {
            if (ev.value_mask & CWX) c.x = c.mon.mx + ev.x;
            if (ev.value_mask & CWY) c.y = c.mon.my + ev.y;
            if (ev.value_mask & CWWidth) c.w = ev.width;
            if (ev.value_mask & CWHeight) c.h = ev.height;
            resizeclient(s, c, c.x, c.y, c.w, c.h);
        } else {
            configure(s, c);
        }
    } else {
        wc: XWindowChanges;
        wc.x = ev.x; wc.y = ev.y;
        wc.width = ev.width; wc.height = ev.height;
        wc.border_width = ev.border_width;
        wc.sibling = ev.above;
        wc.stack_mode = ev.detail;
        XConfigureWindow(s.dpy, ev.window, (unsigned)ev.value_mask, &wc);
    }
    XSync(s.dpy, False);
}

static configurenotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xconfigure;
    if (ev.window != s.root) return;
    dirty := (s.sw != ev.width || s.sh != ev.height);
    s.sw = ev.width;
    s.sh = ev.height;
    if (updategeom(s) || dirty) {
        arrange(s, NULL);
    }
}

static propertynotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xproperty;
    if ev.window == s.root && ev.atom == XA_WM_NAME {
        updatestatus(s);
        drawbar(s, s.selmon);
        return;
    }
    if (ev.state == PropertyDelete) return;
    c := wintoclient(s, ev.window);
    if (!c) return;
    if ev.atom == XA_WM_HINTS {
        updatewmhints(s, c);
        drawbar(s, c.mon);
    } else if ev.atom == XA_WM_NORMAL_HINTS {
        updatesizehints(s, c);
    } else if ev.atom == s.net_wm_name || ev.atom == XA_WM_NAME {
        updatetitle(s, c);
        if (c == s.sel) drawbar(s, c.mon);
    }
}

static clientmessage: (s: *WMState, e: *XEvent) void {
    cme := &e.xclient;
    c   := wintoclient(s, cme.window);
    if (!c) return;
    if cme.message_type == s.net_wm_state {
        if cast(Atom)cme.data.l[1] == s.net_wm_fullscreen ||
           cast(Atom)cme.data.l[2] == s.net_wm_fullscreen
        {
            setfullscreen(s, c, (cme.data.l[0] == 1 || (cme.data.l[0] == 2 && !c.isfullscreen)));
        }
        if cast(Atom)cme.data.l[1] == s.net_wm_sticky ||
           cast(Atom)cme.data.l[2] == s.net_wm_sticky
        {
            setsticky(s, c, (cme.data.l[0] == 1 || (cme.data.l[0] == 2 && !c.issticky)));
        }
    } else if cme.message_type == s.net_active_window {
        if (c != s.sel && !c.isurgent) seturgent(s, c, 1);
    }
}

static mappingnotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xmapping;
    XRefreshKeyboardMapping(ev);
    if (ev.request == MappingKeyboard)
        grabkeys(s);
}

static focusin: (s: *WMState, e: *XEvent) void {
    ev := &e.xfocus;
    if (s.sel && ev.window != s.sel.win)
        setfocus(s, s.sel);
}

static motionnotify: (s: *WMState, e: *XEvent) void {
    ev := &e.xmotion;
    if (ev.window != s.root) return;

    if ev.subwindow {
        c := wintoclient(s, ev.subwindow);
        if (c && c != s.sel)
            focus(s, c);
        return;
    }

    // NOTE: this is static for a reason... it will be used later on
    static mon: *Monitor = NULL;
    if (mon && ev.x_root >= mon.mx && ev.x_root < mon.mx + mon.mw &&
               ev.y_root >= mon.my && ev.y_root < mon.my + mon.mh)
        return;

    m := recttomon(s, ev.x_root, ev.y_root, 1, 1);
    if m != mon && mon {
        unfocus(s, s.sel, 1);
        s.selmon = m;
        focus(s, NULL);
    }
    mon = m;
}

static resizerequest: (s: *WMState, e: *XEvent) void {
    (void)s; (void)e;
}

static spawn: (s: *WMState, arg: *const Arg) void {
    if fork() == 0 {
        if (s.dpy) close(ConnectionNumber(s.dpy));
        setsid();
        argv: **const char = cast(**const char)arg.v;
        execvp(argv[0], argv);
        // execvp(argv[0], (char *const *)argv);
        //                 ^^ idk if the new sytnax support this so for now will use this one
        fprintf(stderr, "rewm: execvp '%s' failed\n", argv[0]);
        exit(1);
    }
}

static getrootptr: (s: *WMState, x: *int, y: *int) int {
    w  : Window;
    di : int;
    dui: unsigned int;
    return XQueryPointer(s.dpy, s.root, &w, &w, x, y, &di, &di, &dui);
}

static restack: (s: *WMState, m: *Monitor) void {
    drawbar(s, m);
    if (!s.sel || s.sel.mon != m) return;
    if (s.sel.isfloating || layouts[m.sellt].arrange == floating)
        XRaiseWindow(s.dpy, s.sel.win);
    if layouts[m.sellt].arrange != floating {
        wc: XWindowChanges;
        wc.stack_mode = Below;
        wc.sibling = m.barwin;
        for c := m.stack; c; c = c.snext; {
            if !c.isfloating && isvisible(m, c) {
                XConfigureWindow(s.dpy, c.win, CWSibling | CWStackMode, &wc);
                wc.sibling = c.win;
            }
        }
    }
}

static tile: (s: *WMState, m: *Monitor) void {
    n := 0;
    for (c := nexttiled(m.clients); c; c = nexttiled(c.next)) n++;
    if (n == 0) return;

    nmaster := m.nmaster;
    if (nmaster < 0) nmaster = 0;
    gap := m.gappx;

    mw := (n > nmaster) ? (nmaster ? (int)(m.ww * m.mfact) : 0) : (m.ww - gap);
    i  := 0;
    my := gap;
    ty := gap;
    for c := nexttiled(m.clients); c; c = nexttiled(c.next), i++; {
        if i < nmaster {
            h := (m.wh - my) / (MIN(n, nmaster) - i) - gap;
            resize(s, c, m.wx + gap, m.wy + my, mw - 2 * c.bw - gap, h - 2 * c.bw, 0);
            if (my + c.h + 2 * c.bw + gap < m.wh) my += c.h + 2 * c.bw + gap;
        } else {
            h := (m.wh - ty) / (n - i) - gap;
            resize(s, c, m.wx + mw + gap, m.wy + ty, m.ww - mw - 2 * c.bw - 2 * gap, h - 2 * c.bw, 0);
            if (ty + c.h + 2 * c.bw + gap < m.wh) ty += c.h + 2 * c.bw + gap;
        }
    }
}

static monocle: (s: *WMState, m: *Monitor) void {
    n := 0;
    for c := m.clients; c; c = c.next; {
        if (isvisible(m, c)) n++;
    }
    if n > 0 {
        snprintf(m.ltsymbol, sizeof(m.ltsymbol), "<%d>", n);
    }
    for c := nexttiled(m.clients); c; c = nexttiled(c.next); {
        resize(s, c, m.wx, m.wy, m.ww - 2 * c.bw, m.wh - 2 * c.bw, 0);
    }
}

static floating: (s: *WMState, m: *Monitor) void {
    for c := m.clients; c; c = c.next; {
        if isvisible(m, c) {
            resize(s, c, c.x, c.y, c.w, c.h, 1);
        }
    }
}

static arrangemon: (s: *WMState, m: *Monitor) void {
    strncpy(m.ltsymbol, layouts[m.sellt].symbol, sizeof(m.ltsymbol) - 1);
    if (layouts[m.sellt].arrange) layouts[m.sellt].arrange(s, m);
}

static arrange: (s: *WMState, m: *Monitor) void {
    if m {
        showhide(s, m.stack);
        arrangemon(s, m);
        restack(s, m);
    } else {
        for (mm := s.mons; mm; mm = mm.next) showhide(s, mm.stack);
        for (mm := s.mons; mm; mm = mm.next) arrangemon(s, mm);
        drawbar(s, s.selmon);
    }
}

static togglebar: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    m := s.selmon;
    m.showbar = !m.showbar;
    updatebarpos(s, m);
    XMoveResizeWindow(s.dpy, m.barwin, m.mx, m.topbar ? m.my : m.my + m.wh,
                      (unsigned)m.ww, (unsigned)s.barheight);
    if (!m.showbar) XUnmapWindow(s.dpy, m.barwin);
    else XMapWindow(s.dpy, m.barwin);
    arrange(s, m);
}

static void focusstack(WMState *s, const Arg *arg) {
    c: *Client = NULL;
    if (!s.sel) return;
    if (s.sel.isfullscreen && lockfullscreen) return;
    if arg.i > 0 {
        for (c = s.sel.next; c && !isvisible(c.mon, c); c = c.next);
        if (!c) for (c = s.selmon.clients; c && !isvisible(c.mon, c); c = c.next);
    } else {
        i: *Client;
        for (i = s.selmon.clients; i != s.sel; i = i.next)
            if (isvisible(i.mon, i)) c = i;
        if (!c) for (; i; i = i.next) if (isvisible(i.mon, i)) c = i;
    }
    if c {
        focus(s, c);
        restack(s, s.selmon);
    }
}

static incnmaster: (s: *WMState, arg: *const Arg) void {
    s.selmon.nmaster = MAX(s.selmon.nmaster + arg.i, 0);
    arrange(s, s.selmon);
}

static setmfact: (s: *WMState, arg: *const Arg) void {
    f := arg.f + s.selmon.mfact;
    if (f < 0.05f || f > 0.95f) return;
    s.selmon.mfact = f;
    arrange(s, s.selmon);
}

static zoom: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    c := s.sel;
    if (!c || layouts[s.selmon.sellt].arrange == floating || c.isfloating)
        return;
    if (c == nexttiled(s.selmon.clients))
        if (!c || !(c = nexttiled(c.next))) return;
    detach(s, c);
    attach(s, c);
    focus(s, c);
    arrange(s, c.mon);
}

static view: (s: *WMState, arg: *const Arg) void {
    if ((arg.ui & TAGMASK) == s.selmon.tagset[s.selmon.seltags]) return;
    s.selmon.seltags ^= 1;
    if (arg.ui & TAGMASK) s.selmon.tagset[s.selmon.seltags] = arg.ui & TAGMASK;
    focus(s, NULL);
    arrange(s, s.selmon);
}

static toggleview: (s: *WMState, arg: *const Arg) void {
    newtags: unsigned int = s.selmon.tagset[s.selmon.seltags] ^ (arg.ui & TAGMASK);
    if (!newtags) return;
    s.selmon.tagset[s.selmon.seltags] = newtags;
    focus(s, NULL);
    arrange(s, s.selmon);
}

static tagclient: (s: *WMState, arg: *const Arg) void {
    if (!s.sel || !(arg.ui & TAGMASK)) return;
    s.sel.tags = arg.ui & TAGMASK;
    focus(s, NULL);
    arrange(s, s.selmon);
}

static toggletag: (s: *WMState, arg: *const Arg) void {
    if (!s.sel) return;
    newtags: unsigned int = s.sel.tags ^ (arg.ui & TAGMASK);
    if (!newtags) return;
    s.sel.tags = newtags;
    focus(s, NULL);
    arrange(s, s.selmon);
}

static killclient: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    if (!s.sel) return;
    if !sendevent(s, s.sel.win, s.wm_protocols, s.wm_delete_window,
                  CurrentTime, 0, 0, 0)
    {
        XGrabServer(s.dpy);
        XSetCloseDownMode(s.dpy, DestroyAll);
        XKillClient(s.dpy, s.sel.win);
        XSync(s.dpy, False);
        XUngrabServer(s.dpy);
    }
}

static togglefloating: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    if (!s.sel || s.sel.isfullscreen) return;
    s.sel.isfloating = !s.sel.isfloating || s.sel.isfixed;
    if (s.sel.isfloating)
        resize(s, s.sel, s.sel.x, s.sel.y, s.sel.w, s.sel.h, 0);
    arrange(s, s.selmon);
}

static togglefullscreen: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    if (!s.sel) return;
    setfullscreen(s, s.sel, !s.sel.isfullscreen);
}

static setlayout: (s: *WMState, arg: *const Arg) void {
    if (arg.i < 0)
        s.selmon.sellt = (s.selmon.sellt + 1) % LAYOUT_COUNT;
    else if (arg.i < LAYOUT_COUNT)
        s.selmon.sellt = arg.i;
    strncpy(s.selmon.ltsymbol, layouts[s.selmon.sellt].symbol, sizeof(s.selmon.ltsymbol) - 1);
    if (s.sel) arrange(s, s.selmon);
    else drawbar(s, s.selmon);
}

static setsticky: (s: *WMState, c: *Client, sticky: int) void {
    if sticky && !c.issticky {
        XChangeProperty(s.dpy, c.win, s.net_wm_state, XA_ATOM, 32,
                        PropModeReplace, cast(*unsigned char)&s.net_wm_sticky, 1);
        c.issticky = 1;
    } else if !sticky && c.issticky {
        XChangeProperty(s.dpy, c.win, s.net_wm_state, XA_ATOM, 32,
                        PropModeReplace, cast(*unsigned char)0, 0);
        c.issticky = 0;
        arrange(s, c.mon);
    }
}

static togglesticky: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    if (!s.sel) return;
    setsticky(s, s.sel, !s.sel.issticky);
    arrange(s, s.selmon);
}

static setgaps: (s: *WMState, arg: *const Arg) void {
    if (arg.i == 0 || s.selmon.gappx + arg.i < 0)
        s.selmon.gappx = 0;
    else
        s.selmon.gappx += arg.i;
    arrange(s, s.selmon);
}

static setgapsabs: (s: *WMState, arg: *const Arg) void {
    s.selmon.gappx = arg.i;
    arrange(s, s.selmon);
}

static setborderpx: (s: *WMState, arg: *const Arg) void {
    if (arg.i == 0 || border_px + arg.i < 0)
        border_px = 0;
    else
        border_px += arg.i;
    for m := s.mons; m; m = m.next; {
        for c := m.clients; c; c = c.next; {
            c.bw = border_px;
            XSetWindowBorderWidth(s.dpy, c.win, (unsigned)c.bw);
        }
    }
    arrange(s, s.selmon);
}

static setborderpxabs: (s: *WMState, arg: *const Arg) void {
    border_px = arg.i < 0 ? 0 : arg.i;
    for m := s.mons; m; m = m.next; {
        for c := m.clients; c; c = c.next; {
            c.bw = border_px;
            XSetWindowBorderWidth(s.dpy, c.win, (unsigned)c.bw);
        }
    }
    arrange(s, s.selmon);
}

static movestack: (s: *WMState, arg: *const Arg) void {
    c : *Client = NULL;
    p : *Client = NULL;
    pc: *Client = NULL;
    i : *Client = NULL;
    mon        := s.selmon;
    if (!s.sel) return;

    if arg.i > 0 {
        for (c = s.sel.next; c && (!isvisible(mon, c) || c.isfloating); c = c.next);
        if !c {
            for (c = mon.clients; c && (!isvisible(mon, c) || c.isfloating); c = c.next);
        }
    } else {
        for i = mon.clients; i != s.sel; i = i.next; {
            if (isvisible(mon, i) && !i.isfloating) c = i;
        }
        if !c {
            for (; i; i = i.next)
                if (isvisible(mon, i) && !i.isfloating) c = i;
        }
    }

    for i = mon.clients; i && (!p || !pc); i = i.next; {
        if (i.next == s.sel) p = i;
        if (i.next == c) pc = i;
    }

    if c && c != s.sel {
        temp := (s.sel.next == c) ? s.sel : s.sel.next;
        s.sel.next = (c.next == s.sel) ? c : c.next;
        c.next = temp;

        if (p && p != c) p.next = c;
        if (pc && pc != s.sel) pc.next = s.sel;

        if (s.sel == mon.clients) mon.clients = c;
        else if (c == mon.clients) mon.clients = s.sel;

        syncglobalclients(s);
        arrange(s, mon);
    }
}

static movemouse: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    c := s.sel;
    last_time = 0;
    if (!c || c.isfullscreen) return;
    restack(s, s.selmon);
    ocx := c.x;
    ocy := c.y;
    if (XGrabPointer(s.dpy, s.root, False,
                     ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
                     GrabModeAsync, GrabModeAsync, None, s.cur_move, CurrentTime) != GrabSuccess)
        return;

    x0: int;
    y0: int;
    if !getrootptr(s, &x0, &y0) {
        XUngrabPointer(s.dpy, CurrentTime);
        return;
    }

    ev: XEvent;
    do {
        XMaskEvent(s.dpy, ButtonPressMask | ButtonReleaseMask | PointerMotionMask | ExposureMask | SubstructureRedirectMask, &ev);
        if ev.type == MotionNotify {
            if ((ev.xmotion.time - last_time) <= (1000 / refreshrate)) continue;
            last_time = ev.xmotion.time;

            nx := ocx + (ev.xmotion.x - x0);
            ny := ocy + (ev.xmotion.y - y0);
            if (abs((s.selmon.wx) - nx) < SNAP_REGION) nx = s.selmon.wx;
            else if (abs((s.selmon.wx + s.selmon.ww) - (nx + c.w)) < SNAP_REGION)
                nx = s.selmon.wx + s.selmon.ww - c.w - (2 * c.bw);
            if (abs(s.selmon.wy - ny) < SNAP_REGION) ny = s.selmon.wy;
            else if (abs((s.selmon.wy + s.selmon.wh) - (ny + c.h)) < SNAP_REGION)
                ny = s.selmon.wy + s.selmon.wh - c.h - (2 * c.bw);
            if !c.isfloating && layouts[s.selmon.sellt].arrange != floating
               && (abs(nx - c.x) > SNAP_REGION || abs(ny - c.y) > SNAP_REGION) {
                c.isfloating = 1;
                arrange(s, s.selmon);
            }
            if (c.isfloating || layouts[s.selmon.sellt].arrange == floating)
                resize(s, c, nx, ny, c.w, c.h, 1);
        } else if ev.type == Expose {
            expose(s, &ev);
        } else if ev.type == MapRequest {
            maprequest(s, &ev);
        }
    } while ev.type != ButtonRelease;
    XUngrabPointer(s.dpy, CurrentTime);
    m := recttomon(s, c.x, c.y, c.w, c.h);
    if m != s.selmon {
        sendmon(s, c, m);
        s.selmon = m;
        focus(s, NULL);
    }
}

static resizemouse: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    last_time = 0;
    c := s.sel;
    if (!c || c.isfullscreen) return;
    restack(s, s.selmon);
    if (XGrabPointer(s.dpy, s.root, False,
                     ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
                     GrabModeAsync, GrabModeAsync, None, s.cur_resize, CurrentTime) != GrabSuccess)
        return;

    XWarpPointer(s.dpy, None, c.win, 0, 0, 0, 0, c.w - 1, c.h - 1);
    ev: XEvent;
    do {
        XMaskEvent(s.dpy, ButtonPressMask | ButtonReleaseMask | PointerMotionMask | ExposureMask | SubstructureRedirectMask, &ev);
        if (ev.type == MotionNotify) {

            if ((ev.xmotion.time - last_time) <= (1000 / refreshrate)) continue;
            last_time = ev.xmotion.time;

            nw := MAX(ev.xmotion.x - c.x + 1, 1);
            nh := MAX(ev.xmotion.y - c.y + 1, 1);
            if !c.isfloating && layouts[s.selmon.sellt].arrange != floating
               && (abs(nw - c.w) > SNAP_REGION || abs(nh - c.h) > SNAP_REGION) {
                c.isfloating = 1;
                arrange(s, s.selmon);
            }
            if (c.isfloating || layouts[s.selmon.sellt].arrange == floating)
                resize(s, c, c.x, c.y, nw, nh, 1);
        } else if ev.type == Expose {
            expose(s, &ev);
        } else if ev.type == MapRequest {
            maprequest(s, &ev);
        }
    } while ev.type != ButtonRelease;
    XWarpPointer(s.dpy, None, c.win, 0, 0, 0, 0, c.w - 1, c.h - 1);
    XUngrabPointer(s.dpy, CurrentTime);
    m := recttomon(s, c.x, c.y, c.w, c.h);
    if m != s.selmon {
        sendmon(s, c, m);
        s.selmon = m;
        focus(s, NULL);
    }
}

static quit: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    cleanup(s);
    exitcode = REWM_QUIT;
    s.running = 0;
}

static reload_wm: (s: *WMState, arg: *const Arg) void {
    (void)arg;
    exitcode = REWM_RELOAD;
    s.running = 0;
}

/* =========================================================================
 *  Multi-monitor support
 * ========================================================================= */
static isuniquegeom: (unique: *XineramaScreenInfo, n: size_t, info: *XineramaScreenInfo) int {
    while n-- {
        if (unique[n].x_org == info.x_org && unique[n].y_org == info.y_org &&
            unique[n].width == info.width && unique[n].height == info.height)
            return 0;
    }
    return 1;
}

static updategeom: (s: *WMState) int {
    dirty := 0;

    if XineramaIsActive(s.dpy) {
	i: int;
	j: int;
	n: int;
	nn: int;
        c: *Client;
        m: *Monitor;

        info := XineramaQueryScreens(s.dpy, &nn);
        if info {
            unique: *XineramaScreenInfo = malloc((size_t)nn * sizeof(*unique));
            if unique {
                for (n = 0, m = s.mons; m; m = m.next, n++);

                /* only consider unique, non-degenerate geometries as
                 * separate screens. an HDMI output that's connected but
                 * unpowered can still show up here with a bogus 0x0 (or
                 * duplicate) mode; without this it gets treated as a
                 * real second monitor and corrupts the whole layout. */
                for (i = 0, j = 0; i < nn; i++)
                    if (info[i].width > 0 && info[i].height > 0 &&
                        isuniquegeom(unique, (size_t)j, &info[i]))
                        unique[j++] = info[i];
                nn = j;

		for (i = n; i < nn; i++) {
                    for (m = s.mons; m && m.next; m = m.next);
                    if (m)
                        m.next = createmon(s);
                    else
                        s.mons = createmon(s);
                }

                /* update geometry for existing + newly-linked monitors */
                for (i = 0, m = s.mons; i < nn && m; m = m.next, i++) {
                    if (i >= n ||
                        unique[i].x_org != m.mx || unique[i].y_org != m.my ||
                        unique[i].width != m.mw || unique[i].height != m.mh) {
                        dirty = 1;
                        m.num = i;
                        m.mx = m.wx = unique[i].x_org;
                        m.my = m.wy = unique[i].y_org;
                        m.mw = m.ww = unique[i].width;
                        m.mh = m.wh = unique[i].height;
                        updatebarpos(s, m);
                        resizebarwin(s, m);
                    }
                }

                /* removed monitors if n > nn -- fold their clients back
                 * onto s.mons instead of leaving them orphaned. */
                for (i = nn; i < n; i++) {
                    for (m = s.mons; m && m.next; m = m.next);
                    while ((c = m.clients)) {
                        dirty = 1;
                        m.clients = c.next;
                        detachstack(s, c);
                        c.mon = s.mons;
                        attachaside(s, c);
                        attachstack(s, c);
                    }
                    if (m == s.selmon)
                        s.selmon = s.mons;
                    cleanupmon(s, m);
                }

                free(unique);
            }
            XFree(info);
        }
    } else {
        if !s.mons {
            s.mons = createmon(s);
        }
        m := s.mons;
        if m.mw != s.sw || m.mh != s.sh {
            dirty = 1;
            m.mw = m.ww = s.sw;
            m.mh = m.wh = s.sh;
            updatebarpos(s, m);
            resizebarwin(s, m);
        }
    }

    if dirty {
        s.selmon = s.mons;
        s.selmon = wintomon(s, s.root);
    }

    if !s.selmon {
        s.selmon = s.mons;
    }

    return dirty;
}

static createmon: (s: *WMState) *Monitor {
    m: *Monitor = calloc(1, sizeof(Monitor));
    if (!m) return NULL;

    m.num = 0;
    m.mfact = DEFAULT_MFACT;
    m.nmaster = DEFAULT_NMASTER;
    m.gappx = DEFAULT_GAP;
    m.showbar = 1;
    m.topbar = 1;
    m.sellt = 0;
    m.tagset[0] = m.tagset[1] = 1;
    strncpy(m.ltsymbol, layouts[0].symbol, sizeof(m.ltsymbol) - 1);

    m.mx = 0;
    m.my = 0;
    m.mw = s.sw;
    m.mh = s.sh;
    m.wx = m.mx;
    m.wy = m.my;
    m.ww = m.mw;
    m.wh = m.mh;
    m.barfocused = -1;

    updatebarpos(s, m);

    /* background_pixmap = ParentRelative only works when the window's
     * depth/visual matches its parent's (root). That's still true in
     * the fallback case (initvisual() couldn't find an ARGB visual,
     * so s.visual/s.depth == the default ones) -- only switch to an
     * explicit background/border pixel + colormap when s.visual is
     * genuinely non-default, or every system without a 32-bit visual
     * ends up staring at a permanent solid-black bar instead of
     * falling back to a normal opaque one. */
    int hasargb = (s.visual != DefaultVisual(s.dpy, s.screen));

    swa: XSetWindowAttributes;
    swa.override_redirect = True;
    if hasargb {
        swa.background_pixel = 0;
        swa.border_pixel = 0;
        swa.colormap = s.cmap;
    } else {
        swa.background_pixmap = ParentRelative;
    }
    swa.event_mask = ExposureMask | ButtonPressMask | SubstructureNotifyMask;
    m.barwin       = XCreateWindow(s.dpy, s.root, m.mx, m.topbar ? m.my : m.my + m.wh,
                                   (unsigned)m.mw, (unsigned)s.barheight, 0, (int)s.depth,
                                   hasargb ? InputOutput : CopyFromParent, s.visual,
                                   hasargb
                                       ? (CWOverrideRedirect | CWBackPixel | CWBorderPixel | CWColormap | CWEventMask)
                                       : (CWOverrideRedirect | CWBackPixmap | CWEventMask),
                                   &swa);
    XDefineCursor(s.dpy, m.barwin, s.cur_normal);
    XMapRaised(s.dpy, m.barwin);
    ch: XClassHint = { "rewm", "rewm" };
    XSetClassHint(s.dpy, m.barwin, &ch);

    m.next = NULL;
    if s.mons {
        last := s.mons;
        while (last.next) last = last.next;
        last.next = m;
        m.num = last.num + 1;
    } else {
        s.mons = m;
    }

    return m;
}

static cleanupmon: (s: *WMState, m: *Monitor) void {
    if (!m) return;

    if m.barwin {
        XUnmapWindow(s.dpy, m.barwin);
        XDestroyWindow(s.dpy, m.barwin);
        m.barwin = 0;
    }

    if m == s.mons {
        s.mons = m.next;
    } else {
        prev := s.mons;
        while (prev && prev.next != m) prev = prev.next;
        if (prev) prev.next = m.next;
    }

    free(m);
}

static dirtomon: (s: *WMState, dir: int) *Monitor {
    m: *Monitor;

    if dir > 0 {
        if (!(m = s.selmon.next))
            m = s.mons;
    } else {
        if (s.selmon == s.mons)
            for (m = s.mons; m.next; m = m.next);
        else
            for (m = s.mons; m.next != s.selmon; m = m.next);
    }
    return m;
}

static focusmon: (s: *WMState, arg: *const Arg) void {
    m := dirtomon(s, arg.i);
    if (m == s.selmon) return;
    unfocus(s, s.sel, 0);
    s.selmon = m;
    focus(s, NULL);
}

static sendmon: (s: *WMState, c: *Client, m: *Monitor) void {
    if (c.mon == m) return;
    unfocus(s, c, 1);
    detach(s, c);
    detachstack(s, c);
    c.mon = m;
    c.tags = m.tagset[m.seltags]; /* assign tags of target monitor, or the
                                   * client silently vanishes -- isvisible()
                                   * checks c.tags against the destination
                                   * monitor's *own* selected tagset, which
                                   * almost never matches whatever tag the
                                   * client had on its old monitor. */
    attach(s, c);
    attachstack(s, c);
    focus(s, NULL);
    arrange(s, NULL);
}

static tagmon: (s: *WMState, arg: *const Arg) void {
    if (!s.sel) return;
    if (!s.mons.next) return;
    sendmon(s, s.sel, dirtomon(s, arg.i));
}

static resizebarwin: (s: *WMState, m: *Monitor) void {
    if (!m || !m.barwin) return;
    XMoveResizeWindow(s.dpy, m.barwin, m.mx, m.topbar ? m.my : m.my + m.wh,
                      (unsigned)m.mw, (unsigned)s.barheight);
}

static scanwindows: (s: *WMState) void {
    root_return: Window;
    parent_return: Window;
    wins: *Window = NULL;
    n: unsigned int = 0;
    if (!XQueryTree(s.dpy, s.root, &root_return, &parent_return, &wins, &n)) return;

    for i := 0U; i < n; i++; {
        wa: XWindowAttributes;
        if (!XGetWindowAttributes(s.dpy, wins[i], &wa)) continue;
        if (wa.override_redirect) continue;
        if (iswmwin(s, wins[i])) continue;
        if (wintoclient(s, wins[i])) continue;

        if wa.map_state == IsViewable {
            trans: Window = None;
            if (XGetTransientForHint(s.dpy, wins[i], &trans)) continue;
            createclient(s, wins[i], &wa);
        } else {
            state: Atom;
            nitems: unsigned long;
            if getstate(s, wins[i]) == IconicState {
                createclient(s, wins[i], &wa);
            }
        }
    }

    if (wins) XFree(wins);
}

static getstate: (s: *WMState, w: Window) long {
    real: Atom;
    format: int;
    n: unsigned long;
    extra: unsigned long;
    data: *unsigned char = NULL;
    result: long = -1;

    if XGetWindowProperty(s.dpy, w, s.wm_state, 0L, 2L, False, s.wm_state,
                          &real, &format, &n, &extra, &data) == Success {
        if (n != 0)
            result = (cast(*long)data).*;
        XFree(data);
    }
    return result;
}

static setupewmh: (s: *WMState) void {
    s.net_supported             = XInternAtom(s.dpy, "_NET_SUPPORTED", False);
    s.net_wm_window_type        = XInternAtom(s.dpy, "_NET_WM_WINDOW_TYPE", False);
    s.net_wm_window_type_dialog = XInternAtom(s.dpy, "_NET_WM_WINDOW_TYPE_DIALOG", False);
    s.net_wm_check              = XInternAtom(s.dpy, "_NET_SUPPORTING_WM_CHECK", False);

    s.wmcheckwin = XCreateSimpleWindow(s.dpy, s.root, 0, 0, 1, 1, 0, 0, 0);
    XChangeProperty(s.dpy, s.wmcheckwin, s.net_wm_check, XA_WINDOW, 32,
                    PropModeReplace, cast(*unsigned char)&s.wmcheckwin, 1);
    XChangeProperty(s.dpy, s.wmcheckwin, s.net_wm_name, s.utf8_string, 8,
                    PropModeReplace, cast(*unsigned char)"rewm", 4);
    XChangeProperty(s.dpy, s.root, s.net_wm_check, XA_WINDOW, 32,
                    PropModeReplace, cast(*unsigned char)&s.wmcheckwin, 1);

    supported: []Atom = {
        s.net_supported, s.net_wm_name, s.net_wm_state, s.net_wm_fullscreen,
        s.net_active_window, s.net_client_list, s.net_wm_window_type,
        s.net_wm_window_type_dialog, s.net_wm_check,
    };
    XChangeProperty(s.dpy, s.root, s.net_supported, XA_ATOM, 32,
                    PropModeReplace, cast(*unsigned char)supported, (int)LENGTH(supported));
    XDeleteProperty(s.dpy, s.root, s.net_client_list);
}

static cleanup: (s: *WMState) void {
    if (!s.initialized) return;

    a: Arg = { .ui = ~0 };
    view(s, &a);

    lt: Layout = { "", NULL };
    for m := s.mons; m; m = m.next; {
        m.sellt = 0;
        strncpy(m.ltsymbol, lt.symbol, sizeof(m.ltsymbol) - 1);
    }

    XUngrabKey(s.dpy, AnyKey, AnyModifier, s.root);

    XSetInputFocus(s.dpy, s.root, RevertToPointerRoot, CurrentTime);

    while s.clients {
        c := s.clients;
        s.clients = c.next;
        XUngrabButton(s.dpy, AnyButton, AnyModifier, c.win);
        setclientstate(s, c, WithdrawnState);
        XSetWindowBorderWidth(s.dpy, c.win, (unsigned)c.oldbw);
        free(c);
    }

    while s.mons {
        cleanupmon(s, s.mons);
    }

    if s.wmcheckwin {
        XDestroyWindow(s.dpy, s.wmcheckwin);
        s.wmcheckwin = 0;
    }

    freexftcolors(s);
    freefonts(s);
    if s.xftdraw  { XftDrawDestroy(s.xftdraw); s.xftdraw = NULL; }
    if s.drawable { XFreePixmap(s.dpy, s.drawable); s.drawable = 0; }
    if s.gc       { XFreeGC(s.dpy, s.gc); s.gc = NULL; }

    XDeleteProperty(s.dpy, s.root, s.net_supported);
    XDeleteProperty(s.dpy, s.root, s.net_wm_check);
    XDeleteProperty(s.dpy, s.root, s.net_client_list);
    XDeleteProperty(s.dpy, s.root, s.net_active_window);

    s.initialized = 0;
}

static now_ms: () long {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

static hasurgentanywhere: (s: *WMState) int {
    for (m := s.mons; m; m = m.next)
        for (c := m.clients; c; c = c.next)
            if (c.isurgent) return 1;
    return 0;
}

wm_entry: (s: *WMState) int {
    exitcode = REWM_QUIT;

    /* Defensive: release any grab that might still be held from a
     * previous wm_entry() invocation (e.g. one that exited mid-drag,
     * or hit an unexpected code path). A stuck Sync-mode grab freezes
     * input for the whole X session, and reload should always be able
     * to recover from that rather than compound it. */
    XUngrabPointer(s.dpy, CurrentTime);
    XUngrabKeyboard(s.dpy, CurrentTime);
    XUngrabServer(s.dpy);
    XAllowEvents(s.dpy, ReplayPointer, CurrentTime);
    XSync(s.dpy, False);

    s.wm_protocols      = XInternAtom(s.dpy, "WM_PROTOCOLS",             False);
    s.wm_delete_window  = XInternAtom(s.dpy, "WM_DELETE_WINDOW",         False);
    s.wm_state          = XInternAtom(s.dpy, "WM_STATE",                 False);
    s.wm_take_focus     = XInternAtom(s.dpy, "WM_TAKE_FOCUS",            False);
    s.net_wm_name       = XInternAtom(s.dpy, "_NET_WM_NAME",             False);
    s.net_wm_state      = XInternAtom(s.dpy, "_NET_WM_STATE",            False);
    s.net_wm_fullscreen = XInternAtom(s.dpy, "_NET_WM_STATE_FULLSCREEN", False);
    s.net_wm_sticky     = XInternAtom(s.dpy, "_NET_WM_STATE_STICKY",     False);
    s.net_active_window = XInternAtom(s.dpy, "_NET_ACTIVE_WINDOW",       False);
    s.net_client_list   = XInternAtom(s.dpy, "_NET_CLIENT_LIST",         False);
    s.utf8_string       = XInternAtom(s.dpy, "UTF8_STRING",              False);

    updatenumlockmask(s);

    /* Must run exactly once -- s.visual is NULL only on the very
     * first call (fresh calloc'd WMState), never reset afterward, so
     * this self-guards without needing a separate flag. Re-running it
     * on reload would allocate a new colormap out from under every
     * already-mapped barwin still referencing the old one. */
    if (!s.visual) initvisual(s);

    setupcolors(s);
    setupfont(s);
    setupdrawable(s);

    for m := s.mons; m; m = m.next; {
        updatebarpos(s, m);
        resizebarwin(s, m);
    }

    if !s.initialized {
        s.sw = DisplayWidth (s.dpy, s.screen);
        s.sh = DisplayHeight(s.dpy, s.screen);

        s.gc = XCreateGC(s.dpy, s.drawable, 0, NULL);
        setupcursors(s);
        setupewmh(s);

        updategeom(s);

        scanwindows(s);

        s.initialized = 1;
    }

    updatestatus(s);

    grabkeys(s);
    XUngrabButton(s.dpy, AnyButton, AnyModifier, s.root);
    XSelectInput(s.dpy, s.root,
                 SubstructureRedirectMask | SubstructureNotifyMask
                 | ButtonPressMask        | PointerMotionMask
                 | EnterWindowMask        | LeaveWindowMask
                 | StructureNotifyMask    | PropertyChangeMask);

    focus(s, s.sel);
    arrange(s, NULL);
    drawbars(s);

    ev: XEvent;
    while XPending(s.dpy) > 0 {
        XNextEvent(s.dpy, &ev);
    }

    s.running = 1;
    XSync(s.dpy, False);
    while s.running && !s.sig_caught {
        if XPending(s.dpy) == 0 {
            if hasurgentanywhere(s) {
                t := now_ms();
                if t - s.last_flash_ms >= URGENT_FLASH_MS {
                    s.last_flash_ms = t;
                    s.urgent_flash_on = !s.urgent_flash_on;
                    drawbars(s);
                }
            } else if s.urgent_flash_on {
                s.urgent_flash_on = 0;
            }
            usleep(5000);
            continue;
        }
        XNextEvent(s.dpy, &ev);
        switch ev.type {
        case ButtonPress:       buttonpress(s, &ev);       break;
        case KeyPress:          keypress(s, &ev);          break;
        case EnterNotify:       enternotify(s, &ev);       break;
        case Expose:            expose(s, &ev);            break;
        case DestroyNotify:     destroynotify(s, &ev);     break;
        case UnmapNotify:       unmapnotify(s, &ev);       break;
        case MapRequest:        maprequest(s, &ev);        break;
        case ConfigureRequest:  configurerequest(s, &ev);  break;
        case ConfigureNotify:   configurenotify(s, &ev);   break;
        case PropertyNotify:    propertynotify(s, &ev);    break;
        case ClientMessage:     clientmessage(s, &ev);     break;
        case MappingNotify:     mappingnotify(s, &ev);     break;
        case FocusIn:           focusin(s, &ev);           break;
        case MotionNotify:      motionnotify(s, &ev);      break;
        case ResizeRequest:     resizerequest(s, &ev);     break;
        }
    }

    XSync(s.dpy, True);
    return exitcode;
}
