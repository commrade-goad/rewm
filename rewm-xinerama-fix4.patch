+static void sendmon(WMState *s, Client *c, Monitor *m) {
+    if (c.mon == m) return;
+    unfocus(s, c, 1);
+    detach(s, c);
+    detachstack(s, c);
+    c.mon = m;
+    c.tags = m.tagset[m.seltags]; /* assign tags of target monitor, or the
+                                    * client silently vanishes -- isvisible()
+                                    * checks c.tags against the destination
+                                    * monitor's *own* selected tagset, which
+                                    * almost never matches whatever tag the
+                                    * client had on its old monitor. */
+    attach(s, c);
+    attachstack(s, c);
     focus(s, NULL);
     arrange(s, NULL);
 }
 
+static void tagmon(WMState *s, const Arg *arg) {
+    if (!s.sel) return;
+    if (!s.mons.next) return;
+    sendmon(s, s.sel, dirtomon(s, arg.i));
+}
