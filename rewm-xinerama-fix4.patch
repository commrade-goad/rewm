  * ========================================================================= */
@@ -2360,6 +2456,16 @@ int wm_entry(WMState *s) {
     XSync(s.dpy, False);
     while (s.running && !s.sig_caught) {
         if (XPending(s.dpy) == 0) {
+            if (hasurgentanywhere(s)) {
+                long t = now_ms();
+                if (t - s.last_flash_ms >= URGENT_FLASH_MS) {
+                    s.last_flash_ms = t;
+                    s.urgent_flash_on = !s.urgent_flash_on;
+                    drawbars(s);
+                }
+            } else if (s.urgent_flash_on) {
+                s.urgent_flash_on = 0;
+            }
             usleep(5000);
             continue;
         }
